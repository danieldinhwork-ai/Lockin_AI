    "db:reset": "node scripts/reset-db.mjs",
    "db:seed": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.12.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
