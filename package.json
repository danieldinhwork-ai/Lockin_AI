{
  "name": "lockin-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LOCKIN.AI – Futuristische Self-Improvement- & Lern-Plattform",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
